---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Layout from "../layout.astro";
import Footer from "../footer.astro";
import Socials from "../socials.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await render(post);
---

<Layout
  mode="article"
  title={`${post.data.title} — TrySound`}
  description={post.data.description}
>
  <header class="article-brand">
    <a href="/" class="brand" aria-label="TrySound forked your repository">
      <span data-article-brand aria-hidden="true">
        TrySound forked your repository
      </span>
    </a>
    <div class="header-socials">
      <Socials />
    </div>
  </header>

  <main>
    <header class="article-header">
      <div class="article-meta">
        <time
          class="metadata"
          style={`view-transition-name: ${post.id}-date;`}
          datetime={post.data.date.toISOString()}
        >
          {post.data.date.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </time>
      </div>
      <h1
        class="article-title"
        style={`view-transition-name: ${post.id}-title;`}
      >
        {post.data.title}
      </h1>
    </header>

    <div class="article-content">
      <Content />
    </div>
  </main>

  <Footer />
</Layout>

<script>
  import { PowerGlitch } from "powerglitch";

  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    PowerGlitch.glitch("[data-article-brand]", {
      playMode: "hover",
      timing: { duration: 600 },
      glitchTimeSpan: { start: 0, end: 0.6 },
      shake: { velocity: 4, amplitudeX: 0.04, amplitudeY: 0.02 },
      slice: { count: 3, velocity: 3, minHeight: 0.02, maxHeight: 0.1 },
    });
  }
</script>

<style>
  .article-brand {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  .header-socials {
    display: none;
    margin-left: auto;
  }

  @media (min-width: 701px) {
    .header-socials {
      display: block;
    }
  }

  @media print {
    .header-socials {
      display: none;
    }
  }

  .brand {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
    view-transition-name: name;
  }

  [data-article-brand] {
    display: inline-block;
  }

  .brand:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 5px;
  }

  .article-header {
    margin-bottom: 2.5rem;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    margin-bottom: 1rem;
  }

  .article-title {
    font-size: 2rem;
    color: var(--text-primary);
    margin-bottom: 1rem;
    line-height: 1.3;
    text-wrap: balance;
  }

  .article-content {
    font-size: clamp(1.125rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.7;
    text-wrap: pretty;
  }

  .article-content :global(h2) {
    font-size: 1.5rem;
    color: var(--text-primary);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .article-content :global(h3) {
    font-size: 1.25rem;
    color: var(--text-primary);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .article-content :global(p) {
    margin-bottom: 1.25rem;
  }

  .article-content :global(hr) {
    border: 0;
    border-top: 1px solid var(--accent);
    margin-block: 2.5rem;
  }

  .article-content :global(blockquote) {
    border-left: 1px solid var(--accent);
    padding: 1rem 1.5rem 0.1rem;
    margin: 1.5rem 0;
    color: var(--text-muted);
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .article-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .article-content :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .article-content :global(code) {
    background: var(--bg-secondary);
    color: var(--accent);
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    font-family: "Monaco", "Menlo", monospace;
    font-size: 1em;
  }

  .article-content :global(pre) {
    background: var(--bg-secondary);
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
    margin-bottom: 1.25rem;
    border: 1px solid var(--border);
  }

  .article-content :global(pre code) {
    background: none;
    padding: 0;
    color: var(--text-secondary);
  }

  .article-content :global(img) {
    max-width: 100%;
    height: auto;
  }

  .article-content :global(a) {
    overflow-wrap: break-word;
  }

  @media (min-width: 640px) {
    .article-title {
      font-size: 2.5rem;
    }
  }
</style>
