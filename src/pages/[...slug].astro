---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Layout from "../layout.astro";
import Footer from "../footer.astro";
import Socials from "../socials.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await render(post);
---

<Layout
  mode="article"
  title={`${post.data.title} — TrySound`}
  description={post.data.description}
>
  <header class="article-brand">
    <a
      href="/"
      class="brand display-sm"
      aria-label="TrySound forked your repository"
    >
      <span data-article-brand aria-hidden="true">
        TrySound forked your repository
      </span>
    </a>
    <div class="header-socials">
      <Socials />
    </div>
  </header>

  <main>
    <header class="article-header">
      <div class="article-meta">
        <time
          class="metadata"
          style={`view-transition-name: ${post.id}-date;`}
          datetime={post.data.date.toISOString()}
        >
          {post.data.date.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </time>
      </div>
      <h1
        class="article-title heading-lg"
        style={`view-transition-name: ${post.id}-title;`}
      >
        {post.data.title}
      </h1>
    </header>

    <div class="prose">
      <Content />
    </div>
  </main>

  <Footer />
</Layout>

<script>
  import { PowerGlitch } from "powerglitch";

  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    PowerGlitch.glitch("[data-article-brand]", {
      playMode: "hover",
      timing: { duration: 600 },
      glitchTimeSpan: { start: 0, end: 0.6 },
      shake: { velocity: 4, amplitudeX: 0.04, amplitudeY: 0.02 },
      slice: { count: 3, velocity: 3, minHeight: 0.02, maxHeight: 0.1 },
    });
  }
</script>

<style>
  .article-brand {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  .header-socials {
    display: none;
    margin-left: auto;
  }

  @media (min-width: 701px) {
    .header-socials {
      display: block;
    }
  }

  @media print {
    .header-socials {
      display: none;
    }
  }

  .brand {
    display: inline-block;
    text-decoration: none;
    view-transition-name: name;
  }

  [data-article-brand] {
    display: inline-block;
  }

  .brand:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 5px;
  }

  .article-header {
    margin-bottom: 2.5rem;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    margin-bottom: 1rem;
  }

  .article-title {
    margin-bottom: 1rem;
  }
</style>
