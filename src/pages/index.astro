---
import { getCollection } from "astro:content";
import Layout from "../layout.astro";
import Socials from "../socials.astro";

const posts = await getCollection("blog");
const sortedPosts = posts
  .filter((post) => !post.data.draft || import.meta.env.DEV)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const adventures = [
  {
    name: "Engramma",
    role: "Author · 2025–present",
    href: "https://github.com/TrySound/engramma",
    description:
      "A home for design tokens. Generate style guides and manage the foundations of a design system.",
  },
  {
    name: "SVGO",
    role: "Maintainer · 2021–2023",
    href: "https://github.com/svg/svgo",
    description:
      "Making SVGs smaller. Rebuilt the plugin system, reduced package size, and improved stability.",
  },
  {
    name: "Rollup",
    role: "Contributor · 2015–2018",
    href: "https://github.com/rollup/rollup",
    description:
      "An ES module bundler. Worked on persistent caching, tree-shaking, and the plugin ecosystem.",
  },
  {
    name: "PostCSS ecosystem",
    role: "Contributor · 2015–2016",
    href: "https://github.com/postcss/postcss",
    description:
      "Transforming CSS with JavaScript. Co-authored cssnano and created postcss-value-parser.",
  },
];
---

<Layout
  fullWidth
  title="TrySound — Bogdan Chadkin"
  description="Also known as Bogdan Chadkin. Here I write about open source and web."
>
  <main>
    <header class="hero">
      <h1 class="title" aria-label="TrySound">
        <span data-index-hero-title aria-hidden="true">
          TrySound
        </span>
      </h1>
      <p class="intro">
        also known as Bogdan Chadkin
        <br />
        Here I write about open source and web.
      </p>
    </header>

    <div
      class="columns"
      style={`--entry-count: ${Math.max(sortedPosts.length, adventures.length)};`}
    >
      <section class="posts" aria-labelledby="posts-title">
        <h2 id="posts-title" class="column-title">
          posts
        </h2>
        <div class="entries">
          {sortedPosts.map((post) => (
            <article>
              <a href={`/${post.id}/`} class="entry">
                <svg class="entry-border" aria-hidden="true">
                  <path pathLength="100" />
                </svg>
                <time
                  class="entry-meta"
                  style={`view-transition-name: ${post.id}-date;`}
                  datetime={post.data.date.toISOString()}
                >
                  {post.data.date.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </time>
                <h3
                  class="entry-title"
                  style={`view-transition-name: ${post.id}-title;`}
                >
                  {post.data.title}
                </h3>
                <p
                  class="entry-description"
                  style={`view-transition-name: ${post.id}-description;`}
                >
                  {post.data.description}
                </p>
              </a>
            </article>
          ))}
        </div>
      </section>

      <section class="adventures" aria-labelledby="adventures-title">
        <h2 id="adventures-title" class="column-title">
          open source adventures
        </h2>
        <div class="entries">
          {adventures.map((adventure) => (
            <article>
              <a href={adventure.href} class="entry">
                <svg class="entry-border" aria-hidden="true">
                  <path pathLength="100" />
                </svg>
                <span class="entry-meta">{adventure.role}</span>
                <h3 class="entry-title">{adventure.name}</h3>
                <p class="entry-description">{adventure.description}</p>
              </a>
            </article>
          ))}
        </div>
      </section>
    </div>
  </main>

  <footer class="home-footer">
    <a href="/rss.xml">RSS feed</a>
    <Socials />
  </footer>
</Layout>

<script>
  import { PowerGlitch } from "powerglitch";

  // Use real pixel geometry: stretching a viewBox distorts dash lengths.
  const borderObserver = new ResizeObserver((entries) => {
    for (const {
      target,
      contentRect: { width, height },
    } of entries) {
      const cap = Math.min(24, width / 2);
      target
        .querySelector("path")!
        .setAttribute(
          "d",
          `M ${width - cap} 0 H ${width} V ${height} H 0 V 0 Z`,
        );
      const visible = ((height + 2 * cap) / (2 * (width + height))) * 100;
      (target as SVGSVGElement).style.setProperty(
        "--border-dashes",
        `${visible} ${100 - visible}`,
      );
    }
  });
  document.querySelectorAll(".entry-border").forEach((border) => {
    borderObserver.observe(border);
  });

  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    PowerGlitch.glitch("[data-index-hero-title]", {
      playMode: "always",
      timing: { duration: 14000 },
      glitchTimeSpan: { start: 0.12, end: 0.16 },
      shake: { velocity: 4, amplitudeX: 0.04, amplitudeY: 0.02 },
      slice: { count: 3, velocity: 3, minHeight: 0.02, maxHeight: 0.1 },
    });
  }
</script>

<style>
  .hero {
    padding-block: clamp(3rem, 8vw, 7rem) clamp(4rem, 7vw, 6rem);
    text-align: center;
  }

  .title {
    display: inline-block;
    color: var(--accent);
    font-size: clamp(3.5rem, 8vw, 7rem);
    line-height: 1.15;
    text-shadow: 0 0 40px rgb(34 197 94 / 15%);
    margin-bottom: 1.25rem;
    view-transition-name: name;
  }

  [data-index-hero-title] {
    display: inline-block;
  }

  .intro {
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.8;
    text-wrap: balance;
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: auto repeat(var(--entry-count), auto);
    gap: 1rem 1.25rem;
  }

  .columns > section {
    display: grid;
    grid-row: 1 / -1;
    grid-template-rows: subgrid;
  }

  .column-title {
    color: var(--text-secondary);
    font-size: 1rem;
    letter-spacing: 0.08em;
    margin-bottom: 1.75rem;
    padding-inline: clamp(1.25rem, 3vw, 3rem);
  }

  .entries {
    display: grid;
    grid-row: 2 / -1;
    grid-template-rows: subgrid;
  }

  .entry {
    --border-duration: 800ms;
    position: relative;
    display: grid;
    align-content: start;
    height: 100%;
    gap: 0.75rem;
    padding: clamp(1.25rem, 3vw, 3rem);
    color: inherit;
    text-decoration: none;
    transition: background-color 400ms ease;
    isolation: isolate;
  }

  .entry::before {
    content: "";
    position: absolute;
    inset: 1px;
    z-index: -1;
    pointer-events: none;
    background-image:
      repeating-linear-gradient(
        0deg,
        rgb(160 185 168 / 3%) 0 1px,
        transparent 1px 3px
      ),
      repeating-linear-gradient(
        0deg,
        rgb(5 12 8 / 18%) 0 1px,
        transparent 1px 5px
      ),
      repeating-linear-gradient(
        1deg,
        rgb(102 145 117 / 4%) 0 1px,
        transparent 1px 7px
      );
    opacity: 0;
    transition: opacity 400ms ease;
  }

  .entry-border {
    position: absolute;
    inset: 0.5px;
    width: calc(100% - 1px);
    height: calc(100% - 1px);
    fill: none;
    stroke: var(--accent);
    stroke-width: 1px;
    opacity: 0.5;
    pointer-events: none;
    overflow: visible;
    transition:
      opacity var(--border-duration) ease,
      filter var(--border-duration) ease;
  }

  .entry-border path {
    stroke-dasharray: var(--border-dashes);
    transition: stroke-dasharray var(--border-duration) linear;
  }

  .adventures .entry-border {
    transform: scaleX(-1);
  }

  .entry:is(:hover, :focus-visible) {
    background-color: rgb(34 197 94 / 3%);
    transition-delay: var(--border-duration);
  }

  .entry:is(:hover, :focus-visible)::before {
    opacity: 1;
    transition-delay: var(--border-duration);
  }

  .entry:is(:hover, :focus-visible) .entry-border {
    opacity: 1;
    filter: drop-shadow(0 0 5px rgb(34 197 94 / 40%));
  }

  .entry:is(:hover, :focus-visible) .entry-border path {
    stroke-dasharray: 100 0;
  }

  .entry:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 5px;
  }

  .entry-meta {
    color: var(--text-muted);
    font-family: monospace;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
  }

  .entry-title {
    color: var(--text-primary);
    font-size: clamp(1.25rem, 2vw, 1.7rem);
    line-height: 1.35;
    text-wrap: pretty;
  }

  .entry-description {
    font-size: 0.95rem;
    max-width: 60ch;
    text-wrap: pretty;
  }

  .home-footer {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 5rem;
    padding: 2rem clamp(1.25rem, 3vw, 3rem) 0;
  }

  .home-footer > a {
    color: var(--text-muted);
    font-family: monospace;
    font-size: 0.8rem;
  }

  @media (max-width: 700px) {
    .columns {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      gap: 3rem;
    }

    .columns > section {
      display: block;
      grid-row: auto;
    }

    .entries {
      grid-row: auto;
      grid-template-rows: none;
      gap: 1rem;
    }

    .adventures .entry-border {
      transform: none;
    }

    .home-footer {
      margin-top: 3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .entry,
    .entry:is(:hover, :focus-visible),
    .entry::before,
    .entry:is(:hover, :focus-visible)::before,
    .entry-border,
    .entry-border path {
      transition: none;
    }
  }
</style>
