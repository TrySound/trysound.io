---
import { getCollection } from "astro:content";
import Layout from "../layout.astro";
import Footer from "../footer.astro";

const posts = await getCollection("blog");
const sortedPosts = posts
  .filter((post) => !post.data.draft || import.meta.env.DEV)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const adventures = [
  {
    name: "SVGO",
    role: "Core maintainer",
    period: "2020–present",
    href: "https://github.com/svg/svgo",
  },
  {
    name: "Rollup",
    role: "Core maintainer & plugin author",
    period: "2015–2021",
    href: "https://github.com/rollup/rollup",
  },
  {
    name: "React Virtualized",
    role: "Core maintainer",
    period: "2017–2019",
    href: "https://github.com/bvaughn/react-virtualized",
  },
  {
    name: "PostCSS",
    role: "Core maintainer & plugin author",
    period: "2015–2017",
    href: "https://github.com/postcss/postcss",
  },
  {
    name: "cssnano",
    role: "Co-creator",
    period: "2015–2016",
    href: "https://github.com/cssnano/cssnano",
  },
];

const projects = [
  {
    name: "Libras",
    role: "Creator",
    period: "2026–present",
    href: "https://github.com/TrySound/libras",
    description:
      "A minimalistic player for your own music server, with offline listening.",
  },
  {
    name: "Engramma",
    role: "Creator",
    period: "2025–present",
    href: "https://github.com/TrySound/engramma",
    description: "A design-token editor with live previews and style guides.",
  },
  {
    name: "Rifm",
    role: "Co-creator",
    period: "2018–present",
    href: "https://github.com/realadvisor/rifm",
    description: "A small React library for formatted and masked inputs.",
  },
];
---

<Layout mode="wide">
  <main>
    <header class="hero">
      <h1 class="title display-lg" aria-label="TrySound forked your repository">
        <span data-index-hero-title aria-hidden="true">
          TrySound forked your repository
        </span>
      </h1>
    </header>

    <div class="stack-lg">
      <div
        class="columns"
        style={`--entry-count: ${Math.max(sortedPosts.length, projects.length)};`}
      >
        <section aria-labelledby="posts-title">
          <h2 id="posts-title" class="column-title label">
            posts
          </h2>
          <div class="entries">
            {sortedPosts.map((post) => (
              <article>
                <a href={`/${post.id}/`} class="card">
                  <svg class="card-border" aria-hidden="true">
                    <rect width="100%" height="100%" pathLength="100" />
                  </svg>
                  <time
                    class="metadata"
                    style={`view-transition-name: ${post.id}-date;`}
                    datetime={post.data.date.toISOString()}
                  >
                    {post.data.date.toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "long",
                      day: "numeric",
                    })}
                  </time>
                  <h3
                    class="heading-md"
                    style={`view-transition-name: ${post.id}-title;`}
                  >
                    {post.data.title}
                  </h3>
                  <p
                    class="text-body"
                    style={`view-transition-name: ${post.id}-description;`}
                  >
                    {post.data.description}
                  </p>
                </a>
              </article>
            ))}
          </div>
        </section>

        <section class="projects" aria-labelledby="projects-title">
          <h2 id="projects-title" class="column-title label">
            my projects
          </h2>
          <div class="entries">
            {projects.map((project) => (
              <article>
                <a
                  href={project.href}
                  class="card"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <svg class="card-border" aria-hidden="true">
                    <rect width="100%" height="100%" pathLength="100" />
                  </svg>
                  <span class="metadata">
                    {project.role} · {project.period}
                  </span>
                  <h3 class="heading-md">{project.name}</h3>
                  <p class="text-body">{project.description}</p>
                </a>
              </article>
            ))}
          </div>
        </section>
      </div>

      <section class="stack-md" aria-labelledby="adventures-title">
        <h2 id="adventures-title" class="column-title label">
          open source adventures
        </h2>
        <div class="adventure-grid">
          {adventures.map((adventure) => (
            <article>
              <a
                href={adventure.href}
                class="card"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg class="card-border" aria-hidden="true">
                  <rect width="100%" height="100%" pathLength="100" />
                </svg>
                <span class="metadata">
                  {adventure.role} · {adventure.period}
                </span>
                <h3 class="heading-md">{adventure.name}</h3>
              </a>
            </article>
          ))}
        </div>
      </section>
    </div>
  </main>

  <div class="footer-container">
    <Footer />
  </div>
</Layout>

<script>
  import { PowerGlitch } from "powerglitch";

  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    PowerGlitch.glitch("[data-index-hero-title]", {
      playMode: "always",
      timing: { duration: 14000 },
      glitchTimeSpan: { start: 0.12, end: 0.16 },
      shake: { velocity: 4, amplitudeX: 0.04, amplitudeY: 0.02 },
      slice: { count: 3, velocity: 3, minHeight: 0.02, maxHeight: 0.1 },
    });
  }
</script>

<style>
  .hero {
    padding-block: clamp(3rem, 8vw, 7rem) clamp(4rem, 7vw, 6rem);
    text-align: center;
  }

  .title {
    display: inline-block;
    view-transition-name: name;
  }

  [data-index-hero-title] {
    display: inline-block;
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: auto repeat(var(--entry-count), auto);
    gap: var(--space-md);
  }

  .columns > section {
    display: grid;
    grid-row: 1 / -1;
    grid-template-rows: subgrid;
  }

  .adventure-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md);
  }

  .column-title {
    padding-inline: clamp(1.25rem, 2vw, 2rem);
  }

  .entries {
    display: grid;
    grid-row: 2 / -1;
    grid-template-rows: subgrid;
    gap: var(--space-md);
  }

  .projects .card-border,
  .adventure-grid > article:nth-child(even) .card-border {
    transform: scaleX(-1);
  }

  .footer-container {
    padding-inline: clamp(1.25rem, 2vw, 2rem);
  }

  @media (max-width: 700px) {
    .columns {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      gap: var(--space-lg);
    }

    .columns > section {
      grid-row: auto;
      grid-template-rows: none;
      row-gap: var(--space-md);
    }

    .entries {
      grid-row: auto;
      grid-template-rows: none;
    }

    .adventure-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .projects .card-border,
    .adventure-grid > article:nth-child(even) .card-border {
      transform: none;
    }
  }
</style>
