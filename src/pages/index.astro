---
import { getCollection } from "astro:content";
import Layout from "../layout.astro";
import Footer from "../footer.astro";

const posts = await getCollection("blog");
const sortedPosts = posts
  .filter((post) => !post.data.draft || import.meta.env.DEV)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const adventures = [
  {
    name: "SVGO",
    role: "Core maintainer",
    period: "2020–present",
    href: "https://github.com/svg/svgo",
  },
  {
    name: "Rollup",
    role: "Core maintainer & plugin author",
    period: "2015–2021",
    href: "https://github.com/rollup/rollup",
  },
  {
    name: "React Virtualized",
    role: "Core maintainer",
    period: "2017–2019",
    href: "https://github.com/bvaughn/react-virtualized",
  },
  {
    name: "PostCSS",
    role: "Core maintainer & plugin author",
    period: "2015–2017",
    href: "https://github.com/postcss/postcss",
  },
  {
    name: "cssnano",
    role: "Co-creator",
    period: "2015–2016",
    href: "https://github.com/cssnano/cssnano",
  },
];

const projects = [
  {
    name: "Libras",
    role: "Creator",
    period: "2026–present",
    href: "https://github.com/TrySound/libras",
    description:
      "A minimalistic player for your own music server, with offline listening.",
  },
  {
    name: "Engramma",
    role: "Creator",
    period: "2025–present",
    href: "https://github.com/TrySound/engramma",
    description: "A design-token editor with live previews and style guides.",
  },
  {
    name: "Rifm",
    role: "Co-creator",
    period: "2018–present",
    href: "https://github.com/realadvisor/rifm",
    description: "A small React library for formatted and masked inputs.",
  },
];
---

<Layout mode="wide">
  <main>
    <header class="hero">
      <h1 class="title display-lg" aria-label="TrySound forked your repository">
        <span data-index-hero-title aria-hidden="true">
          TrySound forked your repository
        </span>
      </h1>
    </header>

    <div
      class="columns"
      style={`--entry-count: ${Math.max(sortedPosts.length, projects.length)};`}
    >
      <section aria-labelledby="posts-title">
        <h2 id="posts-title" class="column-title label">
          posts
        </h2>
        <div class="entries">
          {sortedPosts.map((post) => (
            <article>
              <a href={`/${post.id}/`} class="entry">
                <svg class="entry-border" aria-hidden="true">
                  <rect width="100%" height="100%" pathLength="100" />
                </svg>
                <time
                  class="metadata"
                  style={`view-transition-name: ${post.id}-date;`}
                  datetime={post.data.date.toISOString()}
                >
                  {post.data.date.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </time>
                <h3
                  class="heading-md"
                  style={`view-transition-name: ${post.id}-title;`}
                >
                  {post.data.title}
                </h3>
                <p
                  class="entry-description text-body"
                  style={`view-transition-name: ${post.id}-description;`}
                >
                  {post.data.description}
                </p>
              </a>
            </article>
          ))}
        </div>
      </section>

      <section class="projects" aria-labelledby="projects-title">
        <h2 id="projects-title" class="column-title label">
          my projects
        </h2>
        <div class="entries">
          {projects.map((project) => (
            <article>
              <a
                href={project.href}
                class="entry"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg class="entry-border" aria-hidden="true">
                  <rect width="100%" height="100%" pathLength="100" />
                </svg>
                <span class="metadata">
                  {project.role} · {project.period}
                </span>
                <h3 class="heading-md">{project.name}</h3>
                <p class="entry-description text-body">{project.description}</p>
              </a>
            </article>
          ))}
        </div>
      </section>
    </div>

    <section class="adventures" aria-labelledby="adventures-title">
      <h2 id="adventures-title" class="column-title label">
        open source adventures
      </h2>
      <div class="adventure-grid">
        {adventures.map((adventure) => (
          <article>
            <a
              href={adventure.href}
              class="entry"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg class="entry-border" aria-hidden="true">
                <rect width="100%" height="100%" pathLength="100" />
              </svg>
              <span class="metadata">
                {adventure.role} · {adventure.period}
              </span>
              <h3 class="heading-md">{adventure.name}</h3>
            </a>
          </article>
        ))}
      </div>
    </section>
  </main>

  <div class="footer-container">
    <Footer />
  </div>
</Layout>

<script>
  import { PowerGlitch } from "powerglitch";

  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    PowerGlitch.glitch("[data-index-hero-title]", {
      playMode: "always",
      timing: { duration: 14000 },
      glitchTimeSpan: { start: 0.12, end: 0.16 },
      shake: { velocity: 4, amplitudeX: 0.04, amplitudeY: 0.02 },
      slice: { count: 3, velocity: 3, minHeight: 0.02, maxHeight: 0.1 },
    });
  }
</script>

<style>
  @property --entry-border-visible {
    syntax: "<number>";
    inherits: false;
    initial-value: 100;
  }

  @property --entry-border-gap {
    syntax: "<number>";
    inherits: false;
    initial-value: 0;
  }

  @property --entry-border-offset {
    syntax: "<number>";
    inherits: false;
    initial-value: 0;
  }

  .hero {
    padding-block: clamp(3rem, 8vw, 7rem) clamp(4rem, 7vw, 6rem);
    text-align: center;
  }

  .title {
    display: inline-block;
    view-transition-name: name;
  }

  [data-index-hero-title] {
    display: inline-block;
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: auto repeat(var(--entry-count), auto);
    gap: 1rem 1.25rem;
  }

  .columns > section {
    display: grid;
    grid-row: 1 / -1;
    grid-template-rows: subgrid;
  }

  .adventures {
    margin-top: 4rem;
  }

  .adventure-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 1.25rem;
  }

  .column-title {
    margin-bottom: 1.75rem;
    padding-inline: clamp(1.25rem, 2vw, 2rem);
  }

  .entries {
    display: grid;
    grid-row: 2 / -1;
    grid-template-rows: subgrid;
  }

  .entry {
    --border-duration: 800ms;
    position: relative;
    display: grid;
    align-content: start;
    height: 100%;
    gap: 0.75rem;
    padding: clamp(1.25rem, 2vw, 2rem);
    color: inherit;
    text-decoration: none;
    transition: background-color 400ms ease;
    isolation: isolate;
  }

  .entry::before {
    content: "";
    position: absolute;
    inset: 1px;
    z-index: -1;
    pointer-events: none;
    background-image:
      repeating-linear-gradient(
        0deg,
        rgb(160 185 168 / 3%) 0 1px,
        transparent 1px 3px
      ),
      repeating-linear-gradient(
        0deg,
        rgb(5 12 8 / 18%) 0 1px,
        transparent 1px 5px
      ),
      repeating-linear-gradient(
        1deg,
        rgb(102 145 117 / 4%) 0 1px,
        transparent 1px 7px
      );
    opacity: 0;
    transition: opacity 400ms ease;
  }

  .entry-border {
    position: absolute;
    inset: 0.5px;
    width: calc(100% - 1px);
    height: calc(100% - 1px);
    fill: none;
    stroke: var(--accent);
    stroke-width: 1px;
    opacity: 0.5;
    pointer-events: none;
    overflow: visible;
    transition:
      opacity var(--border-duration) ease,
      filter var(--border-duration) ease;

    rect {
      transition: stroke-dasharray var(--border-duration) linear;
    }
  }

  /* tan(atan2(a, b)) computes a/b without newer typed CSS division.
   * Registered numbers keep calc() out of SVG dash properties for Firefox. */
  @supports (opacity: calc(tan(atan2(1px, 1px)))) and (container-type: size) {
    .entry-border {
      container-type: size;

      rect {
        --entry-border-cap: min(48px, 50cqw);
        --entry-border-perimeter: calc(2 * (100cqw + 100cqh));
        --entry-border-visible: calc(
          100 *
            tan(
              atan2(
                100cqh + 2 * var(--entry-border-cap),
                var(--entry-border-perimeter)
              )
            )
        );
        --entry-border-gap: calc(100 - var(--entry-border-visible));
        --entry-border-offset: calc(
          -100 *
            tan(
              atan2(
                100cqw - var(--entry-border-cap),
                var(--entry-border-perimeter)
              )
            )
        );
        stroke-dasharray: var(--entry-border-visible) var(--entry-border-gap);
        stroke-dashoffset: var(--entry-border-offset);
      }
    }
  }

  .projects .entry-border,
  .adventure-grid > article:nth-child(even) .entry-border {
    transform: scaleX(-1);
  }

  .entry:is(:hover, :focus-visible) {
    background-color: rgb(34 197 94 / 3%);
    transition-delay: var(--border-duration);
  }

  .entry:is(:hover, :focus-visible)::before {
    opacity: 1;
    transition-delay: var(--border-duration);
  }

  .entry:is(:hover, :focus-visible) .entry-border {
    opacity: 1;
    filter: drop-shadow(0 0 5px rgb(34 197 94 / 40%));
  }

  .entry:is(:hover, :focus-visible) .entry-border rect {
    stroke-dasharray: 100 0;
  }

  .entry:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 5px;
  }

  .entry-description {
    max-width: 60ch;
  }

  .footer-container {
    padding-inline: clamp(1.25rem, 2vw, 2rem);
  }

  @media (max-width: 700px) {
    .columns {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      gap: 3rem;
    }

    .columns > section {
      display: block;
      grid-row: auto;
    }

    .entries {
      grid-row: auto;
      grid-template-rows: none;
      gap: 1rem;
    }

    .adventure-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .projects .entry-border,
    .adventure-grid > article:nth-child(even) .entry-border {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .entry,
    .entry:is(:hover, :focus-visible),
    .entry::before,
    .entry:is(:hover, :focus-visible)::before,
    .entry-border,
    .entry-border rect {
      transition: none;
    }
  }
</style>
